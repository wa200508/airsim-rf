# Build the pinned ProjectAirSim source checkout as an actual headless API host.
# Context: .deps/ProjectAirSim-runtime (see scripts/build_airsim_runtime.sh).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-13 libc++-13-dev libc++abi-13-dev cmake ninja-build git ca-certificates \
    build-essential python3 perl pkg-config libssl-dev zlib1g-dev curl unzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/projectairsim
COPY . .
ARG BUILD_JOBS=4
RUN cmake -S . -B build/runtime -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && cmake --build build/runtime --target projectairsim-runtime -j ${BUILD_JOBS}
EXPOSE 8989 8990
ENTRYPOINT ["/opt/projectairsim/build/runtime/samples/projectairsim_runtime/projectairsim-runtime"]
