{
  "schema_version": 1,
  "id": "direction-finding-rf-skill",
  "revision": "1",
  "title": "Direction Finding RF Skill",
  "selectors": [
    {
      "id": "receiver",
      "label": "Receiver I/Q stream",
      "options": [
        {
          "value": "0",
          "label": "Site 0 · element 0",
          "available": {
            "path": "/receiver_spectra/0/psd/frequency_khz"
          }
        },
        {
          "value": "1",
          "label": "Site 1 · element 0",
          "available": {
            "path": "/receiver_spectra/1/psd/frequency_khz"
          }
        }
      ]
    }
  ],
  "panels": [
    {
      "id": "psd",
      "type": "line",
      "title": "Receiver I/Q spectrum",
      "x": {
        "data": {
          "path": "/receiver_spectra/{receiver}/psd/frequency_khz"
        },
        "label": "Frequency offset",
        "unit": "kHz"
      },
      "y": {
        "label": "PSD",
        "unit": "dB re 1 V²/Hz",
        "range": [
          -180,
          -105
        ]
      },
      "series": {
        "path": "/receiver_spectra/{receiver}/psd/density_db_v2_hz"
      },
      "caption": "Selected receiver, element 0; measured post-ADC complex volts."
    },
    {
      "id": "waterfall",
      "type": "waterfall",
      "title": "Receiver I/Q waterfall",
      "x": {
        "data": {
          "path": "/receiver_spectra/{receiver}/psd/frequency_khz"
        },
        "label": "Frequency offset",
        "unit": "kHz"
      },
      "y": {
        "label": "Acquisition windows · newest at top"
      },
      "rows": {
        "path": "/waterfall",
        "each": "/site_psd_db/{receiver}"
      },
      "color": {
        "label": "PSD",
        "unit": "dB re 1 V²/Hz",
        "range": [
          -178,
          -113
        ]
      },
      "caption": "Received windows only; no interpolation across missing data."
    },
    {
      "id": "bearings",
      "type": "metrics",
      "title": "Direction-finding candidates",
      "items": [
        {
          "label": "Site 0 bearing",
          "value": {
            "path": "/bearings/0/angle_deg"
          },
          "unit": "°",
          "precision": 1,
          "valid_when": {
            "path": "/bearings/0/detected"
          },
          "empty": "No stable MUSIC peak"
        },
        {
          "label": "Site 0 received power",
          "value": {
            "path": "/bearings/0/received_power_dbm"
          },
          "unit": "dBm",
          "precision": 1
        },
        {
          "label": "Site 1 bearing",
          "value": {
            "path": "/bearings/1/angle_deg"
          },
          "unit": "°",
          "precision": 1,
          "valid_when": {
            "path": "/bearings/1/detected"
          },
          "empty": "No stable MUSIC peak"
        },
        {
          "label": "Site 1 received power",
          "value": {
            "path": "/bearings/1/received_power_dbm"
          },
          "unit": "dBm",
          "precision": 1
        }
      ],
      "caption": "A candidate is not proof of an unambiguous emitter bearing. A linear array retains front/back and elevation ambiguity."
    },
    {
      "id": "spatial",
      "type": "polar",
      "title": "MUSIC spatial search",
      "x": {
        "data": {
          "path": "/angle_grid_deg"
        },
        "label": "Azimuth from array broadside",
        "unit": "°",
        "period": 360
      },
      "y": {
        "label": "Pseudospectrum",
        "unit": "dB",
        "range": [
          -65,
          0
        ],
        "ticks": [
          -40,
          -20,
          0
        ]
      },
      "series": {
        "path": "/music_db"
      },
      "legend": [
        "Site 0",
        "Site 1"
      ],
      "caption": "Full-circle display; 0° is array broadside. Multipath peaks can be echoes."
    },
    {
      "id": "eigen",
      "type": "line",
      "title": "Covariance eigenvalues",
      "x": {
        "index_start": 1,
        "label": "Eigenvalue rank"
      },
      "y": {
        "label": "Relative power",
        "unit": "dB",
        "range": [
          -60,
          0
        ]
      },
      "series": {
        "path": "/eigenvalues_db"
      },
      "legend": [
        "Site 0",
        "Site 1"
      ],
      "points": true
    },
    {
      "id": "phase",
      "type": "line",
      "title": "Site 0 relative element phase",
      "x": {
        "index_start": 0,
        "label": "Element index"
      },
      "y": {
        "label": "Phase",
        "unit": "rad",
        "range": [
          -9,
          9
        ]
      },
      "series": {
        "path": "/phase_rad"
      },
      "points": true,
      "caption": "Ideal clock and array phase calibration; up to 24,000 simultaneous ADC samples per analysis."
    }
  ],
  "histories": [
    {
      "key": "waterfall",
      "limit": 60,
      "row": {
        "timestamp_ns": {
          "path": "/timestamp_ns"
        },
        "psd_db": {
          "path": "/psd/density_db_v2_hz"
        },
        "site_psd_db": {
          "path": "/receiver_spectra",
          "each": "/psd/density_db_v2_hz"
        }
      }
    }
  ]
}
