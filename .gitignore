.venv/
__pycache__/
*.egg-info/
.pytest_cache/
*.npz
!docs/figures/terrain_scan_iq.npz
!docs/figures/pluto_esm_iq.npz
research/
!src/airsim_rf/research/
!src/airsim_rf/research/*.py
.deps/
recordings/
# Keep large GPU profiler traces / IQ local; commit Markdown + small JSON/logs.
results/profiling/*/raw/

# End-to-end receiver recordings are regenerated locally.
results/end_to_end/*/captures/

# Nested end-to-end captures in profiling bundles stay local.
results/profiling/**/captures/

# Nested profiling binaries are local diagnostics.
results/profiling/**/raw/

# Reproducible scientific plot values.
!docs/figures/sensing_products.npz

# Review smoke captures are regenerated; publish metadata and reports only.
results/reviews/**/captures/
# ProjectAirSim client writes its task-local log in the working directory.
projectairsim_client.log
