# syntax=docker/dockerfile:1
# Independent receiver application; shared simulator/RF runtime for other roles.
ARG BASE_IMAGE=ghcr.io/wa200508/airsim-rf:latest
ARG DF_SKILL_IMAGE=ghcr.io/wa200508/df-skill:sha-270bfacb6ac933f5c60599aab3edf39489978c45
FROM ${BASE_IMAGE} AS runtime
USER root
WORKDIR /opt/airsim-rf
COPY --chmod=755 . /opt/airsim-rf/
# Keep dependencies and simulator extraction in one layer: the download archive
# is removed before committing, and low-disk Docker builders avoid large copies.
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      export PIP_CERT=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; \
    fi; \
    python -m pip install --no-cache-dir -r requirements-p100-cuda.txt \
      -r requirements-p100-propagation.txt -r requirements-tracking-lock.txt; \
    if [ -f /run/secrets/proxy_ca ]; then \
      apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca update; \
      apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends \
        xvfb xauth xdg-user-dirs mesa-vulkan-drivers libgl1-mesa-dri libxkbcommon0 libxrandr2 libxi6 \
        libxcursor1 libxinerama1 libxss1 libxxf86vm1 libasound2t64 libnss3 vulkan-tools; \
    else \
      apt-get update; apt-get install -y --no-install-recommends \
        xvfb xauth xdg-user-dirs mesa-vulkan-drivers libgl1-mesa-dri libxkbcommon0 libxrandr2 libxi6 \
        libxcursor1 libxinerama1 libxss1 libxxf86vm1 libasound2t64 libnss3 vulkan-tools; \
    fi; rm -rf /var/lib/apt/lists/*; \
    python scripts/prepare_unreal_blocks.py --output /tmp/blocks-download; \
    mv /tmp/blocks-download/extracted /opt/blocks; rm -rf /tmp/blocks-download; \
    chmod -R a+rX /opt/blocks; mkdir -p /work/dashboard /.drjit; \
    chown rf:rf /work/dashboard; chmod 1777 /.drjit
ENV HOME=/tmp MPLCONFIGDIR=/tmp/matplotlib \
    PYTHONPATH=/opt/airsim-rf/src NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
    org.opencontainers.image.source="https://github.com/wa200508/airsim-rf" \
    org.opencontainers.image.title="AirSim RF GPU dashboard" \
    org.opencontainers.image.description="Bundled ProjectAirSim, Pascal-compatible CUDA RF, independent Direction Finding RF Skill and localhost mission dashboard"
USER rf

# Backward-compatible target/tag alias of the independently published DF image.
# No receiver implementation is built or copied from this repository.
FROM ${DF_SKILL_IMAGE} AS skill

FROM runtime AS render
ENV RF_BLOCKS_DIR=/opt/blocks
HEALTHCHECK NONE
ENTRYPOINT ["python", "/opt/airsim-rf/deploy/dashboard/render-entrypoint.py"]
CMD []

FROM runtime AS gpu
HEALTHCHECK NONE
ENTRYPOINT ["python", "-m", "airsim_rf.cuda_launch", "-m", "airsim_rf.dashboard_producer"]
CMD ["--run-dir", "/run", "--pascal-compat", "--wait-for-mission"]

# CPU radar consumer contains only receiver contracts and processing code.
# No Sionna/AirSim/CUDA or direction-finding application is installed.
FROM python:3.12.14-slim-trixie AS radar-skill
WORKDIR /opt/radar
COPY --chmod=755 requirements-radar-skill.txt LICENSE /opt/radar/
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python -m pip install --no-cache-dir -r requirements-radar-skill.txt
COPY --chmod=755 src/airsim_rf/__init__.py src/airsim_rf/sample_stream.py /opt/radar/src/airsim_rf/
COPY --chmod=755 src/airsim_rf/processing/__init__.py src/airsim_rf/processing/results.py /opt/radar/src/airsim_rf/processing/
COPY --chmod=755 src/airsim_rf/skills/__init__.py src/airsim_rf/skills/radar.py /opt/radar/src/airsim_rf/skills/
COPY --chmod=755 scripts/qualify_radar_skill.py /opt/radar/scripts/qualify_radar_skill.py
ENV PYTHONPATH=/opt/radar/src HOME=/tmp PYTHONDONTWRITEBYTECODE=1
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      org.opencontainers.image.source="https://github.com/wa200508/airsim-rf" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="FMCW Radar RF Skill"
USER 10001:10001
ENTRYPOINT ["python", "-m", "airsim_rf.skills.radar"]
CMD ["--arrays", "/config/arrays.json", "--results-dir", "/results"]
